an:hover { border-color: rgba(0, 242, 255, .28); background: #0d1518; }\n  .plan-main { min-width: 0; }\n  .plan-title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; }\n  .plan-title em {\n    font-style: normal;\n    font-size: 11.5px;\n    font-weight: 600;\n    color: rgba(0, 242, 255, .85);\n    border: 1px solid rgba(0, 242, 255, .2);\n    background: rgba(0, 242, 255, .06);\n    border-radius: 6px;\n    padding: 2px 6px;\n  }\n  .plan-method {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin: 6px 0 0;\n    font-size: 12px;\n    color: var(--ink-3);\n  }\n  .plan-method i { font-size: 13px; color: rgba(0, 242, 255, .6); }\n  .plan-side {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 6px;\n    flex-shrink: 0;\n  }\n  .plan-price {\n    display: flex;\n    align-items: baseline;\n    gap: 5px;\n    font-size: 14px;\n    font-weight: 800;\n    white-space: nowrap;\n  }\n  .plan-price span { font-size: 11.5px; font-weight: 600; color: var(--ink-3); }\n  .stock {\n    display: inline-flex;\n    align-items: center;\n    height: 22px;\n    padding: 0 8px;\n    border-radius: 999px;\n    font-size: 11px;\n    font-weight: 600;\n    border: 1px solid rgba(110, 231, 183, .2);\n    background: rgba(110, 231, 183, .07);\n    color: #a7f3d0;\n    white-space: nowrap;\n  }\n  .stock.unknown {\n    border-color: rgba(252, 211, 77, .2);\n    background: rgba(252, 211, 77, .06);\n    color: #fde68a;\n  }\n  .stock.multi { color: #a7f3d0; }\n\n  /* ---------- guide ---------- */\n  .guide {\n    margin-top: 24px;\n    padding: 24px;\n    border-radius: 20px;\n    border: 1px solid rgba(0, 242, 255, .15);\n    background: linear-gradient(135deg, rgba(0, 242, 255, .05), rgba(8, 11, 12, .94) 46%);\n  }\n  .guide h2 {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin: 0;\n    font-size: 17px;\n    line-height: 30px;\n    font-weight: 800;\n  }\n  .guide h2 i 