      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n  .nb {\n    --ink: #ffffff;\n    --ink-2: rgba(255, 255, 255, .8);\n    --ink-3: rgba(255, 255, 255, .62);\n    --ink-4: rgba(255, 255, 255, .44);\n    --line: rgba(255, 255, 255, .1);\n    --line-2: rgba(255, 255, 255, .06);\n    --cyan: #00f2ff;\n    --s1: #071012;\n    --s2: #0b1114;\n    --s3: #111a1e;\n    background: #000000;\n    color: var(--ink);\n    font-family: 'Vazirmatn', Tahoma, sans-serif;\n    direction: rtl;\n    min-height: 100vh;\n    padding: 24px 0 0;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  .nb *,\n  .nb *::before,\n  .nb *::after { box-sizing: border-box; }\n\n  .nb svg { display: block; }\n\n  .nb i[class^=\"icon-\"] {\n    display: inline-block;\n    line-height: 1;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n\n  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }\n\n  .wrap {\n    max-width: 1240px;\n    margin: 0 auto;\n    padding: 0 32px 56px;\n  }\n\n  /* ---------- header ---------- */\n  .hdr {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    padding-bottom: 20px;\n  }\n  .hdr-id { display: flex; align-items: center; gap: 14px; }\n  .logo {\n    width: 52px;\n    height: 52px;\n    border-radius: 14px;\n    object-fit: cover;\n    border: 1px solid rgba(0, 242, 255, .26);\n    box-shadow: 0 0 22px rgba(0, 242, 255, .16);\n  }\n  .wordmark {\n    font-size: 19px;\n    font-weight: 800;\n    letter-spacing: -.01em;\n    line-height: 26px;\n  }\n  .wordmark span { color: var(--cyan); font-weight: 700; }\n  .tagline {\n    margin: 4px 0 0;\n    font-size: 13px;\n    line-height: 22px;\n    color: var(--ink-3);\n    max-width: 560px;\n  }\n  .trust {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    height: 40px;\n    padding: 0 14px;\n    border-radius: 12px;\n    border: 1px solid rgba(0, 242, 255, .2);\n    background: rgba(0, 242, 255, .05);\n    color: rgba(0, 242, 255, .88);\n    font-size: 12.5px;\n    white-space: nowrap;\n  }\n\n  /* ---------- nav ---------- */\n  .nav {\n    display: flex;\n    gap: 4px;\n    border-bottom: 1px solid var(--line);\n  }\n  .tab {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    height: 44px;\n    padding: 0 16px;\n    border: none;\n    background: transparent;\n    color: var(--ink-3);\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 600;\n    cursor: pointer;\n    border-radius: 10px 10px 0 0;\n    position: relative;\n  }\n  .tab i { font-size: 16px; opacity: .85; }\n  .tab:hover { color: var(--ink); background: rgba(255, 255, 255, .03); }\n  .tab.active { color: var(--cyan); background: rgba(0, 242, 255, .06); }\n  .tab.active::after {\n    content: \"\";\n    position: absolute;\n    right: 12px;\n    left: 12px;\n    bottom: -1px;\n    height: 2px;\n    border-radius: 2px;\n    background: var(--cyan);\n  }\n\n  /* ---------- opening ---------- */\n  .opening {\n    display: grid;\n    grid-template-columns: 38fr 62fr;\n    gap: 24px;\n    margin-top: 24px;\n    align-items: stretch;\n  }\n  .intro {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 16px;\n    padding: 8px 0 8px 12px;\n  }\n  .h1 {\n    margin: 0;\n    font-size: 32px;\n    line-height: 52px;\n    font-weight: 800;\n    letter-spacing: -.015em;\n    text-wrap: balance;\n  }\n  .h1 span { color: var(--cyan); white-space: nowrap; }\n  .lede {\n    margin: 0;\n    font-size: 14px;\n    line-height: 28px;\n    color: var(--ink-3);\n    max-width: 340px;\n  }\n\n  /* ---------- featured ---------- */\n  .featured {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    padding: 28px;\n    border-radius: 28px;\n    background: var(--s1);\n    border: 1px solid rgba(0, 242, 255, .16);\n    overflow: hidden;\n  }\n  .feat-edge {\n    position: absolute;\n    inset: 0 0 auto 0;\n    height: 2px;\n    background: linear-gradient(90deg, var(--cyan), rgba(0, 242, 255, .18) 65%, transparent);\n  }\n  .feat-title {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin: 0;\n    font-size: 19px;\n    line-height: 34px;\n    font-weight: 800;\n  }\n  .feat-title i { font-size: 18px; color: var(--cyan); }\n  .feat-copy {\n    margin: 8px 0 0;\n    font-size: 13px;\n    line-height: 26px;\n    color: var(--ink-3);\n    max-width: 640px;\n  }\n  .record {\n    display: grid;\n    grid-template-columns: 72px minmax(0, 1fr) auto;\n    gap: 20px;\n    align-items: center;\n    padding-top: 20px;\n    border-top: 1px solid var(--line-2);\n  }\n  .mark {\n    width: 44px;\n    height: 44px;\n    border-radius: 12px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    color: var(--brand, #fff);\n    border: 1px solid color-mix(in srgb, var(--brand, #ffffff) 30%, rgba(255, 255, 255, .1));\n    background: color-mix(in srgb, var(--brand, #ffffff) 16%, transparent);\n  }\n  .mark svg { width: 24px; height: 24px; }\n  .mark-lg { width: 72px; height: 72px; border-radius: 20px; }\n  .mark-lg svg { width: 40px; height: 40px; }\n\n  .rec-brand {\n    margin: 0;\n    font-size: 12px;\n    letter-spacing: .04em;\n    color: var(--ink-4);\n  }\n  .rec-title {\n    margin: 4px 0 0;\n    font-size: 21px;\n    line-height: 32px;\n    font-weight: 800;\n  }\n  .rec-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }\n  .pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    height: 26px;\n    padding: 0 10px;\n    border-radius: 8px;\n    border: 1px solid var(--line);\n    background: rgba(255, 255, 255, .03);\n    font-size: 12px;\n    color: var(--ink-2);\n    white-space: nowrap;\n  }\n  .pill i { font-size: 13px; }\n  .pill.cyan {\n    color: #b9fcff;\n    border-color: rgba(0, 242, 255, .28);\n    background: rgba(0, 242, 255, .07);\n  }\n  .pill.ok {\n    color: #a7f3d0;\n    border-color: rgba(110, 231, 183, .22);\n    background: rgba(110, 231, 183, .07);\n  }\n  .rec-buy {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 12px;\n  }\n  .price {\n    display: flex;\n    align-items: baseline;\n    gap: 8px;\n    margin: 0;\n    font-size: 36px;\n    line-height: 1;\n    font-weight: 800;\n    color: var(--cyan);\n    white-space: nowrap;\n  }\n  .price span { font-size: 13px; font-weight: 600; color: rgba(255, 255, 255, .72); }\n  .cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    height: 44px;\n    padding: 0 20px;\n    border: none;\n    border-radius: 12px;\n    background: var(--cyan);\n    color: #00161a;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 800;\n    cursor: pointer;\n    white-space: nowrap;\n  }\n  .rail {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    min-height: 44px;\n    padding-top: 16px;\n    border-top: 1px solid var(--line-2);\n  }\n  .rail-left { display: flex; align-items: center; gap: 8px; }\n  .arw {\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    border: 1px solid var(--line);\n    background: rgba(255, 255, 255, .03);\n    color: var(--ink-2);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 15px;\n    cursor: pointer;\n  }\n  .arw:hover { border-color: rgba(0, 242, 255, .4); color: var(--cyan); }\n  .counter { font-size: 12px; color: var(--ink-4); margin-inline-start: 6px; }\n  .rail-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 12.5px;\n    font-weight: 600;\n    color: rgba(0, 242, 255, .9);\n    text-decoration