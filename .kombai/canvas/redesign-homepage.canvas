    },
    "var_d11ae5e0d888": {
      "type": "variant",
      "label": "نسخه ۳ — صراحت‌محور",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n:root{\n  --cyan:#00F2FF;\n  --s1:#080b0c;\n  --s2:#0b1114;\n  --s3:#111a1e;\n  --line:rgba(255,255,255,.08);\n  --line-2:rgba(255,255,255,.13);\n  --t1:rgba(255,255,255,.93);\n  --t2:rgba(255,255,255,.66);\n  --t3:rgba(255,255,255,.44);\n}\nbody{margin:0;background:#000}\n.page{\n  background:#000;color:var(--t1);direction:rtl;\n  font-family:'Vazirmatn','Tahoma',sans-serif;\n  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;\n  padding-bottom:8px;\n}\n.page *{box-sizing:border-box}\n.wrap{max-width:1240px;margin:0 auto;padding:24px 24px 32px}\n\n/* ---------- header ---------- */\n.site-head{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-bottom:16px;border-bottom:1px solid var(--line)}\n.identity{display:flex;align-items:center;gap:12px;min-width:0}\n.logo{width:44px;height:44px;border-radius:11px;object-fit:cover;border:1px solid rgba(0,242,255,.26);box-shadow:0 0 18px rgba(0,242,255,.14)}\n.wordmark{display:flex;align-items:center;gap:7px;font-size:18px;font-weight:800;line-height:1.4}\n.wm-sep{color:rgba(255,255,255,.26);font-weight:400}\n.wm-fa{color:var(--cyan);font-weight:700}\n.tagline{margin:3px 0 0;font-size:12px;line-height:1.8;color:var(--t2);max-width:640px}\n.trust{display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 13px;border:1px solid var(--line-2);border-radius:999px;font-size:12px;color:var(--t2);white-space:nowrap}\n.trust i{font-size:14px;color:var(--cyan)}\n\n/* ---------- tabs ---------- */\n.tabs{display:flex;gap:8px;margin-top:12px;overflow-x:auto;scrollbar-width:none}\n.tabs::-webkit-scrollbar{display:none}\n.tab{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.02);color:var(--t2);font-size:13.5px;text-decoration:none;white-space:nowrap;transition:color .18s,border-color .18s,background .18s}\n.tab i{font-size:16px}\n.tab:hover{color:#fff;border-color:var(--line-2)}\n.tab.is-active{color:var(--cyan);border-color:rgba(0,242,255,.4);background:rgba(0,242,255,.08)}\n\n/* ---------- opening ---------- */\n.opening{display:grid;grid-template-columns:1fr 1.78fr;gap:24px;margin-top:24px;align-items:stretch}\n.hero{display:flex;flex-direction:column;justify-content:space-between;padding:22px 4px 22px 0}\nh1{margin:0;font-size:30px;line-height:1.62;font-weight:800;letter-spacing:0}\n.hl{color:var(--cyan)}\n.hero-copy{margin:12px 0 0;font-size:14px;line-height:1.95;color:var(--t2);max-width:380px}\n.facts{display:grid;grid-template-columns:1fr 1fr;gap:20px 18px;margin-top:32px}\n.fact{display:flex;gap:10px;align-items:flex-start}\n.fact i{font-size:17px;color:var(--cyan);margin-top:3px;flex:0 0 auto}\n.fact-value{display:block;font-size:17px;font-weight:800;line-height:1.5}\n.fact-label{display:block;margin-top:1px;font-size:11.5px;color:var(--t3);line-height:1.7}\n\n/* ---------- disclosure ---------- */\n.disclosure{background:var(--s1);border:1px solid var(--line);border-radius:12px;padding:24px}\n.disclosure-head{display:flex;align-items:flex-start;gap:12px}\n.ico{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;border:1px solid rgba(0,242,255,.22);background:rgba(0,242,255,.07);color:var(--cyan);flex:0 0 auto}\n.ico i{font-size:16px}\n.disclosure h2{margin:2px 0 0;font-size:19px;line-height:1.65;font-weight:800}\n.disclosure p{margin:16px 0 0;font-size:14px;line-height:2;color:rgba(255,255,255,.85)}\n\n/* ---------- featured offer ---------- */\n.offer{margin-top:24px;background:#071012;border:1px solid rgba(0,242,255,.17);border-radius:20px;padding:22px 24px 0;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px 32px}\n.offer-head h2{display:flex;align-items:center;gap:8px;margin:0;font-size:17.5px;line-height:1.7;font-weight:800}\n.offer-head h2 i{font-size:16px;color:var(--cyan)}\n.offer-head p{max-width:560px;margin:8px 0 0;font-size:12.5px;line-height:1.95;color:var(--t2)}\n.record{display:flex;align-items:center;gap:16px;align-self:start;padding-top:2px}\n.mark{display:inline-flex;align-items:center;justify-content:center;border-radius:12px;background:linear-gradient(150deg,rgba(255,255,255,.07),rgba(255,255,255,.015));border:1px solid color-mix(in srgb,var(--brand) 34%,rgba(255,255,255,.07));color:var(--brand);box-shadow:inset 0 0 20px color-mix(in srgb,var(--brand) 11%,transparent);flex:0 0 auto}\n.mark svg{width:100%;height:100%;display:block}\n.record .mark{width:56px;height:56px;padding:11px}\n.record-main{min-width:0}\n.record-name{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:800;white-space:nowrap}\n.record-sub{margin-top:4px;font-size:11.5px;color:var(--t2)}\n.record-meta{display:flex;align-items:center;gap:9px;margin-top:9px;font-size:10.5px;color:var(--t3)}\n.rule{width:1px;height:10px;background:var(--line-2)}\n.brand-label{font-size:11px;color:var(--t3)}\n.chip{display:inline-flex;align-items:center;height:20px;padding:0 8px;border-radius:6px;font-size:10.5px;line-height:1;white-space:nowrap}\n.chip-quiet{border:1px solid var(--line-2);color:var(--t2);background:rgba(255,255,255,.03)}\n.chip-flag{border:1px solid rgba(0,242,255,.25);color:rgba(0,242,255,.85);background:rgba(0,242,255,.07)}\n.record-buy{display:flex;align-items:center;gap:16px}\n.price{display:flex;flex-direction:column;align-items:flex-start;line-height:1.15}\n.price .amount{font-size:28px;font-weight:800;color:#fff}\n.price .unit{font-size:11px;font-weight:500;color:var(--t3);margin-top:3px}\n.btn-primary{height:44px;padding:0 20px;border:0;border-radius:10px;background:var(--cyan);color:#04191b;font-size:12.5px;font-weight:800;font-family:inherit;cursor:pointer;white-space:nowrap}\n.offer-rail{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:16px;margin:16px -24px 0;padding:10px 24px 12px;border-top:1px solid var(--line)}\n.carousel{display:flex;align-items:center;gap:8px}\n.round{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;border:1px solid var(--line-2);background:transparent;color:var(--t2);cursor:pointer;font-family:inherit}\n.round:hover{color:#fff;border-color:rgba(0,242,255,.4)}\n.round i{font-size:15px}\n.counter{font-size:11px;color:var(--t3);margin-inline-start:6px}\n.rail-link{font-size:11.5px;color:var(--t2);text-decoration:none}\n.rail-link:hover{color:var(--cyan)}\n\n/* ---------- discovery ---------- */\n.discovery{margin-top:24px;display:flex;flex-direction:column;gap:12px}\n.chip-row{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}\n.chip-row::-webkit-scrollbar{display:none}\n.brand-chip{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 10px 0 14px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.02);color:var(--t2);font-size:12.5px;font-family:inherit;cursor:pointer;white-space:nowrap}\n.brand-chip .mark{width:22px;height:22px;padding:3px;border-radius:6px;box-shadow:none}\n.brand-chip.is-active{color:#fff;border-color:rgba(0,242,255,.38);background:rgba(0,242,255,.08)}\n.search{display:flex;align-items:center;gap:12px;height:44px;padding:0 16px;border:1px solid var(--line-2);border-radius:10px;background:#090c0d}\n.search i{font-size:17px;color:var(--t3)}\n.search input{flex:1;min-width:0;height:100%;border:0;background:transparent;color:#fff;font-size:13.5px;font-family:inherit;outline:none}\n.search input::placeholder{color:rgba(255,255,255,.3)}\n.cat-chip{display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.015);color:var(--t2);font-size:12.5px;font-family:inherit;cursor:pointer;white-space:nowrap}\n.cat-chip .count{font-size:11px;color:var(--t3)}\n.cat-chip.is-active{color:var(--cyan);border-color:rgba(0,242,255,.4);background:rgba(0,242,255,.08)}\n.cat-chip.is-active .count{color:rgba(0,242,255,.7)}\n\n/* ---------- section head ---------- */\n.section-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:24px}\n.section-head h2{display:flex;align-items:center;gap:8px;margin:0;font-size:17.5px;font-weight:800}\n.section-head h2 i{font-size:16px;color:var(--cyan)}\n.section-meta{font-size:11.5px;color:var(--t3)}\n\n/* ---------- brand cards ---------- */\n.brand-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;align-items:start}\n.brand-card{background:var(--s2);border:1px solid var(--line);border-radius:16px;overflow:hidden}\n.brand-card.is-featured{grid-column:1 / -1}\n.card-body{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:20px}\n.card-id-block{min-width:0;flex:1}\n.card-head{display:flex;align-items:flex-start;gap:12px}\n.mark-md{width:42px;height:42px;padding:9px;border-radius:11px}\n.card-id{min-width:0;flex:1}\n.card-name{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:800;line-height:1.5;flex-wrap:wrap}\n.name-rule{display:inline-block;width:1px;height:12px;background:var(--line-2)}\n.card-name .fa{font-size:13px;font-weight:600;color:var(--t2)}\n.plan-count{font-size:11px;color:var(--t3);white-space:nowrap;padding-top:5px}\n.card-name .plan-count{padding-top:0;font-weight:500;margin-inline-start:2px}\n.card-plan{display:flex;align-items:center;gap:7px;margin-top:6px;font-size:11.5px;color:var(--t2)}\n.card-summary{margin:11px 0 0;font-size:12.5px;line-height:1.9;color:var(--t2);max-width:430px}\n.card-buy{display:flex;align-items:flex-end;gap:10px;flex:0 0 auto}\n.from-label{display:block;font-size:10.5px;color:var(--t3)}\n.from-price{display:block;margin-top:4px;font-size:21px;font-weight:800;line-height:1.3;white-space:nowrap}\n.from-price .unit{font-size:10.5px;font-weight:500;color:var(--t3);margin-inline-start:4px}\n.guide-link{width:38px;height:38px;border-radius:999px;border:1px solid rgba(0,242,255,.28);background:rgba(0,242,255,.07);color:var(--cyan);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex:0 0 auto}\n.guide-link i{font-size:15px}\n.card-toggle{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:11px 20px;border:0;border-top:1px solid var(--line);background:rgba(255,255,255,.022);color:var(--t2);font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;text-align:right}\n.card-toggle:hover{background:rgba(255,255,255,.04)}\n.card-toggle i{font-size:15px;transition:transform .2s}\n.brand-card.is-open .card-toggle i{transform:rotate(180deg)}\n.plans{background:var(--s3);border-top:1px solid var(--line)}\n.plan-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 20px;align-items:center;padding:13px 20px;border-bottom:1px solid rgba(255,255,255,.06)}\n.plan-row:last-child{border-bottom:0}\n.plan-title{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:#fff;flex-wrap:wrap}\n.plan-method{display:flex;align-items:center;gap:6px;margin-top:5px;font-size:11px;color:var(--t3)}\n.plan-method i{font-size:12px;color:rgba(0,242,255,.55)}\n.plan-side{display:flex;flex-direction:column;align-items:flex-end;gap:5px;min-width:140px}\n.plan-price{font-size:13px;font-weight:800;white-space:nowrap}\n.plan-price .unit{font-size:10px;font-weight:500;color:var(--t3);margin-inline-start:3px}\n.stock{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;white-space:nowrap}\n.stock .dot{width:5px;height:5px;border-radius:999px;background:currentColor}\n.stock.is-in{color:rgba(0,242,255,.8)}\n.stock.is-unknown{color:rgba(245,197,122,.9)}\n\n/* ---------- guide ---------- */\n.guide{margin-top:24px;background:var(--s1);border:1px solid var(--line);border-radius:12px;padding:24px}\n.guide-head{display:flex;align-items:flex-start;gap:12px}\n.guide h2{margin:2px 0 0;font-size:16.5px;line-height:1.7;font-weight:800}\n.guide-cols{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:18px}\n.guide-block h3{margin:0;font-size:12.5px;font-weight:700;color:rgba(255,255,255,.9)}\n.guide-block p{margin:7px 0 0;font-size:12px;line-height:1.95;color:var(--t2)}\n.tips{list-style:none;margin:18px 0 0;padding:18px 0 0;border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.tips li{display:flex;gap:8px;font-size:11.5px;line-height:1.9;color:var(--t2)}\n.tips i{font-size:13px;color:var(--cyan);margin-top:5px;flex:0 0 auto}\n\n/* ---------- footer ---------- */\n.site-foot{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:24px;padding-top:18px;border-top:1px solid var(--line);font-size:11.5px;color:var(--t3)}\n.foot-trust{display:inline-flex;align-items:center;gap:8px}\n.foot-trust i{font-size:13px;color:var(--t2)}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG symbol sprite\" focusable=\"false\" height=\"0\" style=\"position:absolute\" width=\"0\">\n<symbol id=\"b-openai\" viewbox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.7\"><path d=\"M12 2.9 20.2 7.5v9L12 21.1 3.8 16.5v-9z\"></path><path d=\"M12 8.3 15.6 10.4v4.2L12 16.7 8.4 14.6v-4.2z\"></path></g></symbol>\n<symbol id=\"b-claude\" viewbox=\"0 0 24 24\"><g stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.9\"><path d=\"M12 3.4v17.2M4.5 7.7l15 8.6M19.5 7.8 4.5 16.2\"></path></g></symbol>\n<symbol id=\"b-gemini\" viewbox=\"0 0 24 24\"><path d=\"M12 2.4c1.3 5 3.1 7.4 9.6 9.6-6.5 2.2-8.3 4.6-9.6 9.6-1.3-5-3.1-7.4-9.6-9.6 6.5-2.2 8.3-4.6 9.6-9.6z\" fill=\"currentColor\"></path></symbol>\n<symbol id=\"b-spotify\" viewbox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" fill=\"currentColor\" r=\"9.3\"></circle><g fill=\"none\" stroke=\"#071012\" stroke-linecap=\"round\" stroke-width=\"1.7\"><path d=\"M7 9.2c3.6-1.1 7.2-.7 9.9 1M7.6 12.1c2.9-.9 6-.5 8.4 1M8.3 15c2.3-.6 4.5-.3 6.3.7\"></path></g></symbol>\n<symbol id=\"b-youtube\" viewbox=\"0 0 24 24\"><rect fill=\"currentColor\" height=\"13.2\" rx=\"4\" width=\"18.8\" x=\"2.6\" y=\"5.4\"></rect><path d=\"M10.4 9.2 15.3 12l-4.9 2.8z\" fill=\"#07090b\"></path></symbol>\n<symbol id=\"b-netflix\" viewbox=\"0 0 24 24\"><path d=\"M6.1 3.1h3.3l5.3 10.8V3.1h3.2v17.8l-3.3.2-5.3-10.9v10.7H6.1z\" fill=\"currentColor\"></path></symbol>\n<symbol id=\"b-canva\" viewbox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" fill=\"none\" r=\"9.2\" stroke=\"currentColor\" stroke-width=\"1.6\"></circle><path d=\"M15.6 9.6a4.4 4.4 0 1 0 0 4.8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2.1\"></path></symbol>\n<symbol id=\"b-cursor\" viewbox=\"0 0 24 24\"><path d=\"M5.6 3.3 19 12.7l-6.4 1.1-3.2 5.3z\" fill=\"currentColor\"></path></symbol>\n<symbol id=\"b-midjourney\" viewbox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.7\"><path d=\"M6 17.2 12 4.1l5.3 13.1zM12 4.1v13.1\"></path></g><path d=\"M3.6 19.3h16.8l-1.9 2.1H5.5z\" fill=\"currentColor\"></path></symbol>\n<symbol id=\"b-nordvpn\" viewbox=\"0 0 24 24\"><path d=\"M12 2.6 20 5.6v6.1c0 5-3.2 8.5-8 10.3-4.8-1.8-8-5.3-8-10.3V5.6z\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.7\"></path><path d=\"m8.6 11.5 2.3 2.3 4.6-4.6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\"></path></symbol>\n<symbol id=\"b-notion\" viewbox=\"0 0 24 24\"><rect fill=\"none\" height=\"17.2\" rx=\"3\" stroke=\"currentColor\" stroke-width=\"1.6\" width=\"17.2\" x=\"3.4\" y=\"3.4\"></rect><path d=\"M8.5 16.6V7.7l7 8.9V7.6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.9\"></path></symbol>\n<symbol id=\"b-capcut\" viewbox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2\"><path d=\"M4 6.7h4.4L20 17.3h-4.4zM4 17.3h4.4L20 6.7h-4.4z\"></path></g></symbol>\n</svg>\n<div class=\"page\" data-kid=\"2\" data-name=\"page layout container\">\n<div class=\"wrap\" data-kid=\"2-1\" data-name=\"page content wrapper\">\n<header class=\"site-head\" data-kid=\"2-1-1\" data-name=\"site header bar\">\n<div class=\"identity\" data-kid=\"2-1-1-1\" data-name=\"brand identity group\">\n<img alt=\"لوگوی نوبول\" class=\"logo\" data-kid=\"2-1-1-1-1\" data-name=\"site logo image\" decoding=\"async\" height=\"44\" loading=\"lazy\" src=\"/api/local/images/public/logo.jpg\" width=\"44\"/>\n<div data-kid=\"2-1-1-1-2\" data-name=\"brand text block\">\n<div class=\"wordmark\" data-kid=\"2-1-1-1-2-1\" data-name=\"brand wordmark\"><span data-kid=\"2-1-1-1-2-1-1\" data-name=\"English brand name\" dir=\"ltr\">NoBull</span><span class=\"wm-sep\" data-kid=\"2-1-1-1-2-1-2\" data-name=\"wordmark separator pipe\">|</span><span class=\"wm-fa\" data-kid=\"2-1-1-1-2-1-3\" data-name=\"Persian brand name\">نوبول</span></div>\n<p class=\"tagline\" data-kid=\"2-1-1-1-2-2\" data-name=\"brand tagline text\">بی‌حاشیه و روراست؛ اشتراک‌های هوش مصنوعی و دیجیتال ویژه رفقا و خانواده</p>\n</div>\n</div>\n<span class=\"trust\" data-kid=\"2-1-1-2\" data-name=\"trust badge pill\"><i class=\"icon-shield-check\" data-kid=\"2-1-1-2-1\" data-name=\"shield check icon\"></i>خرید امن و شفاف</span>\n</header>\n<nav aria-label=\"بخش‌های نوبول\" class=\"tabs\" data-kid=\"2-1-2\" data-name=\"main navigation tabs\">\n<a aria-current=\"page\" class=\"tab is-active\" data-kid=\"2-1-2-1\" data-name=\"active catalog tab link\" href=\"#\"><i class=\"icon-shopping-bag\" data-kid=\"2-1-2-1-1\" data-name=\"shopping bag icon\"></i>کاتالوگ اشتراک‌ها</a>\n<a class=\"tab\" data-kid=\"2-1-2-2\" data-name=\"account tab link\" href=\"#\"><i class=\"icon-package-check\" data-kid=\"2-1-2-2-1\" data-name=\"package check icon\"></i>حساب کاربری و خریدهای من</a>\n<a class=\"tab\" data-kid=\"2-1-2-3\" data-name=\"2FA code tab link\" href=\"#\"><i class=\"icon-key-round\" data-kid=\"2-1-2-3-1\" data-name=\"key icon\"></i>دریافت کد دو مرحله‌ای (2FA)</a>\n<a class=\"tab\" data-kid=\"2-1-2-4\" data-name=\"admin panel tab link\" href=\"#\"><i class=\"icon-lock\" data-kid=\"2-1-2-4-1\" data-name=\"lock icon\"></i>پنل مدیریت</a>\n</nav>\n<section class=\"opening\" data-kid=\"2-1-3\" data-name=\"opening section with hero and disclosure\">\n<div class=\"hero\" data-kid=\"2-1-3-1\" data-name=\"hero section\">\n<div data-kid=\"2-1-3-1-1\" data-name=\"hero headline group\">\n<h1 data-kid=\"2-1-3-1-1-1\" data-name=\"hero headline text\">اشتراک مناسب خودت را <span class=\"hl\" data-kid=\"2-1-3-1-1-1-1\" data-name=\"hero highlighted phrase\">پیدا کن.</span></h1>\n<p class=\"hero-copy\" data-kid=\"2-1-3-1-1-2\" data-name=\"hero description text\">قیمت شفاف، موجودی به‌روز و تحویل راحت برای رفقا و خانواده.</p>\n</div>\n<div class=\"facts\" data-kid=\"2-1-3-1-2\" data-name=\"hero stats grid\">\n<div class=\"fact\" data-kid=\"2-1-3-1-2-1\" data-name=\"hero stat: number of brands\">\n<i class=\"icon-package-check\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"package check icon\"></i>\n<div data-kid=\"2-1-3-1-2-1-2\" data-name=\"stat value and label wrapper\"><span class=\"fact-value\" data-kid=\"2-1-3-1-2-1-2-1\" data-name=\"stat value text\">+۶۸</span><span class=\"fact-label\" data-kid=\"2-1-3-1-2-1-2-2\" data-name=\"stat label text\">برند معتبر</span></div>\n</div>\n<div class=\"fact\" data-kid=\"2-1-3-1-2-2\" data-name=\"hero stat: instant delivery\">\n<i class=\"icon-zap\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"lightning bolt icon\"></i>\n<div data-kid=\"2-1-3-1-2-2-2\" data-name=\"stat value and label wrapper\"><span class=\"fact-value\" data-kid=\"2-1-3-1-2-2-2-1\" data-name=\"stat value text\">آنی</span><span class=\"fact-label\" data-kid=\"2-1-3-1-2-2-2-2\" data-name=\"stat label text\">تحویل در تلگرام</span></div>\n</div>\n<div class=\"fact\" data-kid=\"2-1-3-1-2-3\" data-name=\"hero stat: friendly pricing\">\n<i class=\"icon-banknote\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"banknote icon\"></i>\n<div data-kid=\"2-1-3-1-2-3-2\" data-name=\"stat value and label wrapper\"><span class=\"fact-value\" data-kid=\"2-1-3-1-2-3-2-1\" data-name=\"stat value text\">تومانی</span><span class=\"fact-label\" data-kid=\"2-1-3-1-2-3-2-2\" data-name=\"stat label text\">قیمت رفاقتی</span></div>\n</div>\n<div class=\"fact\" data-kid=\"2-1-3-1-2-4\" data-name=\"hero stat: 2FA tool\">\n<i class=\"icon-key-round\" data-kid=\"2-1-3-1-2-4-1\" data-name=\"key icon\"></i>\n<div data-kid=\"2-1-3-1-2-4-2\" data-name=\"stat value and label wrapper\"><span class=\"fact-value\" data-kid=\"2-1-3-1-2-4-2-1\" data-name=\"stat value text\">داخلی</span><span class=\"fact-label\" data-kid=\"2-1-3-1-2-4-2-2\" data-name=\"stat label text\">ابزار کد ۲ مرحله‌ای</span></div>\n</div>\n</div>\n</div>\n<aside aria-labelledby=\"disclosure-title\" class=\"disclosure\" data-kid=\"2-1-3-2\" data-name=\"transparency disclosure panel\">\n<div class=\"disclosure-head\" data-kid=\"2-1-3-2-1\" data-name=\"disclosure header row\">\n<span class=\"ico\" data-kid=\"2-1-3-2-1-1\" data-name=\"help icon badge\"><i class=\"icon-circle-help\" data-kid=\"2-1-3-2-1-1-1\" data-name=\"help circle icon\"></i></span>\n<h2 data-kid=\"2-1-3-2-1-2\" data-name=\"disclosure panel title\" id=\"disclosure-title\">صداقت بی‌رحمانه، قیمت واقعی، بدون حاشیه.</h2>\n</div>\n<p data-kid=\"2-1-3-2-2\" data-name=\"disclosure risk explanation paragraph\">این اکانت‌ها همه از آفرهای کشورهای مختلف و ارزان تهیه می‌شوند. به دلیل محدودیت‌های جغرافیایی و رعایت نکردن مواردی مثل استفاده از آی‌پی کثیف یا تحریم‌های ریجنی، احتمال غیرفعال شدن برخی اکانت‌ها وجود دارد؛ اما در صورت رعایت نکات، اکثراً بدون مشکل و بدون ساسپند کار می‌کنند. در کل، خرید این اکانت‌ها در زمره خدمات بازار خاکستری قرار دارد و دارای ریسک مسدودی است. اگر امکان تهیه کارت بانکی بین‌المللی و خرید قانونی را دارید، حتماً از روش قانونی اقدام کنید؛ اما اگر مثل ما شرایط ارزی سختی دارید، حداقل با قیمت منطقی خرید کنید.</p>\n<p data-kid=\"2-1-3-2-3\" data-name=\"disclosure pricing philosophy paragraph\">هیچ‌گونه گارانتیِ دروغین و تضمین صددرصدی از سوی نوبول وجود ندارد؛ به همین دلیل است که قیمت‌ها بسیار پایین و اقتصادی تعیین شده‌اند تا برای شما دوستان عزیز ارزش خرید داشته باشد. توجه داشته باشید که این محصولات دقیقاً همان خدماتی است که خیلی‌ها با چند برابر قیمت، تحت عنوان «ساخت تیم خودمان» یا با گارانتی‌های ساختگی به شما می‌فروشند، در حالی که همه از همین سرچشمه تأمین می‌شوند. هدف ما این است که امکان تهیه این اکانت‌ها به صورت ریالی، با مناسب‌ترین قیمت و اخذ کمترین کارمزد و سود ممکن، برای شما رفقای عزیز فراهم شود.</p>\n</aside>\n</section>\n<section aria-labelledby=\"offer-title\" class=\"offer\" data-kid=\"2-1-4\" data-name=\"featured offer section\">\n<div class=\"offer-head\" data-kid=\"2-1-4-1\" data-name=\"offer header block\">\n<h2 data-kid=\"2-1-4-1-1\" data-name=\"offer headline with tag icon\" id=\"offer-title\"><i class=\"icon-tag\" data-kid=\"2-1-4-1-1-1\" data-name=\"tag icon\"></i>پیشنهادی ویژه: فعال‌سازی روی اکانت شخصی شما</h2>\n<p data-kid=\"2-1-4-1-2\" data-name=\"offer description text\">محصولات دارای کد، کلید فعال‌سازی، دعوت‌نامه یا تحویل شخصی؛ روش، مدت و ضمانت هر محصول را پیش از سفارش بررسی کنید.</p>\n</div>\n<div class=\"record\" data-kid=\"2-1-4-2\" data-name=\"featured product record row\">\n<span class=\"mark\" data-kid=\"2-1-4-2-1\" data-name=\"OpenAI brand logo badge\" style=\"--brand:#10A37F\"><svg aria-hidden=\"true\" data-kid=\"2-1-4-2-1-1\" data-name=\"OpenAI hexagon logo\" viewbox=\"0 0 24 24\"><use href=\"#b-openai\"></use></svg></span>\n<div class=\"record-main\" data-kid=\"2-1-4-2-2\" data-name=\"product record info\">\n<div class=\"record-name\" data-kid=\"2-1-4-2-2-1\" data-name=\"product name and duration row\"><span data-kid=\"2-1-4-2-2-1-1\" data-name=\"product name text\">ChatGPT Plus</span><span class=\"chip chip-quiet\" data-kid=\"2-1-4-2-2-1-2\" data-name=\"duration chip\">۱ ماهه</span></div>\n<div class=\"record-sub\" data-kid=\"2-1-4-2-2-2\" data-name=\"product subtitle description\">کد فعال‌سازی روی اکانت شخصی</div>\n<div class=\"record-meta\" data-kid=\"2-1-4-2-2-3\" data-name=\"product meta info row\">\n<span class=\"brand-label\" data-kid=\"2-1-4-2-2-3-1\" data-name=\"brand label\" dir=\"ltr\">ChatGPT</span>\n<span class=\"rule\" data-kid=\"2-1-4-2-2-3-2\" data-name=\"meta separator divider\"></span>\n<span class=\"stock is-in\" data-kid=\"2-1-4-2-2-3-3\" data-name=\"stock availability indicator\"><span class=\"dot\" data-kid=\"2-1-4-2-2-3-3-1\" data-name=\"stock status dot\"></span>موجود</span>\n<span class=\"chip chip-flag\" data-kid=\"2-1-4-2-2-3-4\" data-name=\"featured selection flag chip\">پیشنهاد منتخب نوبول</span>\n</div>\n</div>\n<div class=\"record-buy\" data-kid=\"2-1-4-2-3\" data-name=\"product buy action group\">\n<div class=\"price\" data-kid=\"2-1-4-2-3-1\" data-name=\"product price display\"><span class=\"amount\" data-kid=\"2-1-4-2-3-1-1\" data-name=\"price amount text\">۴۸۰٬۰۰۰</span><span class=\"unit\" data-kid=\"2-1-4-2-3-1-2\" data-name=\"price currency unit\">تومان</span></div>\n<button class=\"btn-primary\" data-kid=\"2-1-4-2-3-2\" data-name=\"primary buy now button\" type=\"button\">جزئیات و خرید</button>\n</div>\n</div>\n<div class=\"offer-rail\" data-kid=\"2-1-4-3\" data-name=\"offer rail bar\">\n<div class=\"carousel\" data-kid=\"2-1-4-3-1\" data-name=\"carousel navigation controls\">\n<button aria-label=\"پیشنهاد قبلی\" class=\"round\" data-kid=\"2-1-4-3-1-1\" data-name=\"previous offer button\" type=\"button\"><i class=\"icon-chevron-right\" data-kid=\"2-1-4-3-1-1-1\" data-name=\"right chevron icon\"></i></button>\n<button aria-label=\"پیشنهاد بعدی\" class=\"round\" data-kid=\"2-1-4-3-1-2\" data-name=\"next offer button\" type=\"button\"><i class=\"icon-chevron-left\" data-kid=\"2-1-4-3-1-2-1\" data-name=\"left chevron icon\"></i></button>\n<span class=\"counter\" data-k