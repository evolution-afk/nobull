      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n.nb{--cyan:#00F2FF;--card:#0b1114;--card2:#111a1e;--panel:#071012;--line:rgba(255,255,255,.09);--line-2:rgba(255,255,255,.06);--ink:rgba(255,255,255,.9);--ink-2:rgba(255,255,255,.66);--ink-3:rgba(255,255,255,.44);font-family:'Vazirmatn',Tahoma,sans-serif;background:#000;color:#fff;direction:rtl;font-size:14px;line-height:1.6;min-height:100vh;padding:0;margin:0;letter-spacing:0}\n.nb *{box-sizing:border-box}\n.nb p,.nb h1,.nb h2,.nb h3, .nb h4{margin:0;padding:0}\n.nb .sprite{position:absolute;width:0;height:0;overflow:hidden}\n.nb .ic{font-style:normal;line-height:1;display:inline-flex;align-items:center;justify-content:center;font-size:15px}\n.nb .wrap{max-width:1240px;margin:0 auto;padding:24px 24px 44px}\n.nb .mk{width:24px;height:24px;display:block;color:inherit}\n\n/* header */\n.nb .hdr{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-bottom:20px;border-bottom:1px solid var(--line)}\n.nb .brand{display:flex;align-items:center;gap:12px;min-width:0}\n.nb .logo{width:44px;height:44px;border-radius:12px;object-fit:cover;border:1px solid rgba(0,242,255,.28);flex:0 0 auto;display:block}\n.nb .wordmark{display:flex;align-items:baseline;gap:6px;font-size:17px;font-weight:800;letter-spacing:-.01em}\n.nb .wordmark span{color:var(--cyan);font-weight:700}\n.nb .tagline{margin-top:3px;font-size:12.5px;line-height:22px;color:var(--ink-2)}\n.nb .trust{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;border-radius:999px;border:1px solid rgba(0,242,255,.22);background:rgba(0,242,255,.055);color:#9df7fd;font-size:11.5px;white-space:nowrap;flex:0 0 auto}\n\n/* nav */\n.nb .nav{display:flex;gap:8px;margin-top:12px;overflow-x:auto;padding-bottom:2px}\n.nb .nav a{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 14px;border-radius:10px;border:1px solid var(--line);background:#06090a;color:var(--ink-2);font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap;flex:0 0 auto}\n.nb .nav a.on{border-color:rgba(0,242,255,.36);background:rgba(0,242,255,.07);color:var(--cyan)}\n.nb .nav a .ic{font-size:16px}\n\n/* hero */\n.nb .hero{display:grid;grid-template-columns:minmax(0,1fr) 392px;gap:28px;margin-top:20px;padding:20px 24px;border-radius:24px;border:1px solid var(--line);background:radial-gradient(120% 190% at 88% 0%,rgba(0,242,255,.07),rgba(0,242,255,0) 58%),#05080a}\n.nb .hero h1{font-size:28px;line-height:1.62;font-weight:800;letter-spacing:-.01em}\n.nb .hero h1 em{font-style:normal;color:var(--cyan)}\n.nb .hero .lede{margin-top:6px;font-size:14px;line-height:26px;color:var(--ink-2);max-width:560px}\n.nb .facts{display:grid;grid-template-columns:1fr 1fr;gap:14px 20px;align-content:center;border-inline-start:1px solid var(--line);padding-inline-start:28px}\n.nb .fact{display:flex;align-items:flex-start;gap:9px}\n.nb .fact .ic{font-size:15px;color:var(--ink-3);margin-top:3px}\n.nb .fact .v{display:block;font-size:16.5px;font-weight:800;line-height:1.5}\n.nb .fact .l{display:block;font-size:11.8px;line-height:20px;color:var(--ink-2)}\n\n/* featured */\n.nb .feat{margin-top:20px;border-radius:16px;border:1px solid rgba(0,242,255,.18);background:var(--panel);padding:16px 20px 0}\n.nb .feat-top{display:grid;grid-template-columns:minmax(0,1fr) 486px;gap:24px;align-items:center;padding-bottom:14px}\n.nb .feat-head{display:flex;gap:10px}\n.nb .feat-head .ic{font-size:17px;color:var(--cyan);margin-top:3px}\n.nb .feat-head h2{font-size:17px;line-height:1.6;font-weight:800}\n.nb .feat-head p{margin-top:5px;font-size:12.4px;line-height:24px;color:var(--ink-2);max-width:520px}\n.nb .rec{display:flex;align-items:center;gap:12px;padding-inline-start:20px;border-inline-start:1px solid var(--line-2)}\n.nb .tile{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:12px;border:1px solid rgba(255,255,255,.13);background:linear-gradient(145deg,color-mix(in srgb,var(--c) 20%,#080c0e),color-mix(in srgb,var(--c) 5%,#080c0e));color:var(--c)}\n.nb .tile.sm{width:20px;height:20px;border-radius:6px}\n.nb .tile.sm .mk{width:13px;height:13px}\n.nb .tile.md{width:44px;height:44px}\n.nb .tile.lg{width:48px;height:48px}\n.nb .rec-main{min-width:0;flex:1}\n.nb .rec-title{font-size:13.4px;font-weight:800;line-height:1.45;white-space:normal}\n.nb .rec-meta{margin-top:1px;font-size:11.4px;line-height:19px;color:var(--ink-2)}\n.nb .rec-sub{margin-top:3px;display:flex;align-items:center;gap:8px;font-size:11.2px;color:var(--ink-3)}\n.nb .rec-sub .flag{padding:2px 7px;border-radius:5px;border:1px solid rgba(255,255,255,.13);color:var(--ink-2);font-size:10.2px;white-space:nowrap}\n.nb .rec-price{text-align:end;flex:0 0 auto}\n.nb .rec-price .num{display:block;font-size:24px;font-weight:800;line-height:1.25;color:var(--cyan);letter-spacing:-.01em}\n.nb .rec-price .cur{display:block;font-size:11px;color:var(--ink-2);margin-top:1px}\n.nb .cta{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border-radius:10px;background:var(--cyan);color:#00171a;font-size:12.6px;font-weight:800;text-decoration:none;white-space:nowrap;flex:0 0 auto}\n.nb .feat-rail{display:flex;align-items:center;justify-content:space-between;gap:12px;height:42px;margin:0 -20px;padding:0 20px;border-top:1px solid var(--line-2)}\n.nb .rail-l{display:flex;align-items:center;gap:8px}\n.nb .arrow{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;border:1px solid rgba(255,255,255,.13);background:rgba(255,255,255,.02);color:var(--ink-2);font-size:13px}\n.nb .rail-count{font-size:11.2px;color:var(--ink-3);margin-inline-start:4px}\n.nb .rail-link{font-size:11.8px;font-weight:600;color:var(--ink-2);text-decoration:none;border-bottom:1px solid rgba(255,255,255,.2);padding-bottom:1px}\n\n/* discovery */\n.nb .disc{margin-top:20px;display:grid;gap:10px}\n.nb .chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:2px}\n.nb .chip{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 12px;border-radius:999px;border:1px solid var(--line);background:#06090a;color:var(--ink-2);font-size:12.4px;font-weight:500;white-space:nowrap;flex:0 0 auto}\n.nb .chip.on{border-color:rgba(0,242,255,.4);background:rgba(0,242,255,.07);color:var(--cyan);font-weight:700}\n.nb .search{display:flex;align-items:center;gap:10px;height:44px;padding:0 14px;border-radius:12px;border:1px solid rgba(255,255,255,.1);background:#06090a}\n.nb .search .ic{font-size:16px;color:var(--ink-3)}\n.nb .search input{flex:1;min-width:0;height:100%;border:0;outline:none;background:transparent;color:#fff;font-family:inherit;font-size:13.4px}\n.nb .search input::placeholder{color:rgba(255,255,255,.32)}\n.nb .search .hint{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:var(--ink-3);border-inline-start:1px solid var(--line-2);padding-inline-start:12px;white-space:nowrap}\n.nb .cats{display:flex;gap:8px;overflow-x:auto;padding-bottom:2px}\n.nb .cat{display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 13px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.02);color:rgba(255,255,255,.56);font-size:12.4px;white-space:nowrap;flex:0 0 auto}\n.nb .cat .n{font-size:11px;color:var(--ink-3)}\n.nb .cat.on{border-color:rgba(0,242,255,.4);background:rgba(0,242,255,.07);color:var(--cyan)}\n.nb .cat.on .n{color:rgba(0,242,255,.68)}\n\n/* shelf */\n.nb .shelf{margin-top:22px}\n.nb .shelf-hd{display:flex;align-items:flex-end;justify-content:space-between;gap:12px}\n.nb .shelf-hd h2{font-size:17px;font-weight:800}\n.nb .shelf-hd .count{font-size:11.8px;color:var(--ink-3)}\n.nb .cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px;align-items:start}\n.nb .stack{display:grid;gap:12px;min-width:0}\n.nb .card{border-radius:16px;border:1px solid var(--line);background:var(--card);overflow:hidden}\n.nb .card-b{padding:20px}\n.nb .card-top{display:flex;align-items:center;justify-content:space-between;gap:12px}\n.nb .card-top .plans{font-size:11.8px;color:var(--ink-3)}\n.nb .card h3{display:flex;align-items:baseline;gap:6px;margin-top:12px;font-size:15.2px;font-weight:800;line-height:1.6}\n.nb .card h3 .fa{color:var(--ink-2);font-weight:600;font-size:13.4px}\n.nb .card h3 .bar{color:rgba(255,255,255,.28);font-weight:400}\n.nb .low{margin-top:8px;display:flex;align-items:baseline;gap:8px;font-size:12.6px;font-weight:700;color:rgba(255,255,255,.86)}\n.nb .low .dur{font-size:11.2px;font-weight:500;color:var(--ink-3)}\n.nb .sum{margin-top:4px;font-size:12.2px;line-height:22px;color:var(--ink-2);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.nb .priceRow{display:flex;align-items:flex-end;justify-content:flex-start;direction:rtl;gap:12px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line-2)}\n.nb .priceRow>div{flex:1 1 auto;min-width:0}\n.nb .priceRow .lab{display:block;font-size:11.2px;line-height:18px;color:var(--ink-3)}\n.nb .priceRow .val{display:flex;align-items:baseline;gap:5px;margin-top:3px;font-size:26px;font-weight:800;line-height:1.25;color:var(--cyan);letter-spacing:-.01em}\n.nb .priceRow .guideBtn{margin-inline-start:auto}\n.nb .priceRow .val .cur{font-size:11.5px;font-weight:500;color:var(--ink-2);margin-inline-start:4px}\n.nb .guideBtn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;border:1px solid rgba(0,242,255,.28);background:rgba(0,242,255,.07);color:var(--cyan);font-size:16px;flex:0 0 auto}\n.nb .expand{display:flex;align-items:center;justify-content:space-between;width:100%;height:40px;padding:0 20px;border:0;border-top:1px solid var(--line-2);background:rgba(255,255,255,.022);color:var(--ink-2);font-family:inherit;font-size:12.4px;font-weight:600;cursor:pointer}\n.nb .expand .ic{font-size:15px;transition:transform .2s ease}\n.nb .card.open .expand{color:rgba(255,255,255,.9);background:rgba(0,242,255,.05)}\n.nb .card.open .expand .ic{transform:rotate(180deg)}\n.nb .plansBox{border-top:1px solid var(--line-2);background:var(--card2);padding:2px 20px 6px}\n.nb .prow{display:grid;grid-template-columns:minmax(0,1fr) 172px;gap:16px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line-2)}\n.nb .prow:last-child{border-bottom:0}\n.nb .prow .pt{font-size:12.6px;font-weight:700;line-height:1.65;color:rgba(255,255,255,.92)}\n.nb .prow .pm{margin-top:3px;display:flex;align-items:center;gap:6px;font-size:11.2px;color:var(--ink-3)}\n.nb .prow .pm .ic{font-size:12px}\n.nb .prow .end{text-align:end}\n.nb .prow .pp{font-size:13px;font-weight:700}\n.nb .stock{display:inline-block;margin-top:4px;padding:2px 8px;border-radius:999px;font-size:10.4px;border:1px solid rgba(255,255,255,.12);color:var(--ink-2)}\n.nb .stock.in{border-color:rgba(52,211,153,.28);background:rgba(16,185,129,.1);color:#9ff0cd}\n.nb .stock.ask{border-color:rgba(251,191,36,.24);background:rgba(251,191,36,.08);color:#f3dfa4}\n\n/* honesty */\n.nb .note{margin-top:20px;border-radius:16px;border:1px solid var(--line);background:#080b0c;padding:22px 24px}\n.nb .note hd{display:block}\n.nb .note-hd{display:flex;align-items:center;gap:9px}\n.nb .note-hd .ic{font-size:17px;color:var(--ink-2)}\n.nb .note h2{font-size:18px;font-weight:800;line-height:1.6}\n.nb .note-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 28px;margin-top:10px}\n.nb .note-grid p{font-size:13.6px;line-height:28px;color:rgba(255,255,255,.82)}\n\n/* guide */\n.nb .guide{margin-top:20px;border-radius:16px;border:1px solid rgba(0,242,255,.16);background:linear-gradient(135deg,rgba(0,242,255,.055),rgba(6,9,10,.98) 46%),#06090a;padding:20px 24px}\n.nb .guide h2{font-size:16px;font-weight:800;line-height:1.7}\n.nb .guide h2 .ic{font-size:16px;color:var(--cyan);margin-inline-end:4px}\n.nb .guide .blocks{display:grid;grid-template-columns:1fr 1fr;gap:0 28px;margin-top:10px;padding-top:12px;border-top:1px solid var(--line-2)}\n.nb .guide h3{font-size:12.4px;font-weight:700;color:rgba(255,255,255,.88)}\n.nb .guide .blocks p{margin-top:4px;font-size:12.2px;line-height:25px;color:var(--ink-2)}\n.nb .tips{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px 20px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line-2)}\n.nb .tip{display:flex;gap:7px;font-size:11.8px;line-height:24px;color:var(--ink-2)}\n.nb .tip .ic{font-size:13px;color:var(--ink-3);margin-top:5px}\n\n/* footer */\n.nb .foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:26px;padding-top:16px;border-top:1px solid var(--line-2);font-size:11.6px;color:var(--ink-3)}\n.nb .foot .r{display:inline-flex;align-items:center;gap:7px}\n</style>\n<div class=\"nb\" data-kid=\"1\" data-name=\"NoBull storefront page container\">\n<svg aria-hidden=\"true\" class=\"sprite\" data-kid=\"1-1\" data-name=\"hidden SVG icon sprite (brand symbols)\" focusable=\"false\"><defs>\n<symbol id=\"b-openai\" viewbox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 4.1c2.7 1.7 3.5 4.7 2.3 7.9-1.2 3.2-4.1 5-7.1 4\"></path><path d=\"M19.9 12c-2.7 1.7-5.7 1.3-7.8-.9-2.1-2.2-2-5.6 0-8.1\"></path><path d=\"M12 19.9c-2.7-1.7-3.5-4.7-2.3-7.9 1.2-3.2 4.1-5 7.1-4\"></path><path d=\"M4.1 12c2.7-1.7 5.7-1.3 7.8.9 2.1 2.2 2 5.6 0 8.1\"></path></g></symbol>\n<symbol id=\"b-claude\" viewbox=\"0 0 24 24\"><g stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.9\"><path d=\"M12 3.2v4.6M12 16.2v4.6M3.2 12h4.6M16.2 12h4.6M5.7 5.7l3.3 3.3M15 15l3.3 3.3M18.3 5.7 15 9M9 15l-3.3 3\"></path></g></symbol>\n<symbol id=\"b-gemini\" viewbox=\"0 0 24 24\"><path d=\"M12 2.4c1.3 4.9 3 7.3 9.6 9.6-6.6 2.3-8.3 4.7-9.6 9.6-1.3-4.9-3-7.3-9.6-9.6 6.6-2.3 8.3-4.7 9.6-9.6Z\" fill=\"currentColor\"></path></symbol>\n<symbol id=\"b-spotify